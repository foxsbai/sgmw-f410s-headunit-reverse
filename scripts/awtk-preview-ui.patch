+static ret_t screenshot_in_timer(const timer_info_t* info) {
+  widget_t* wm = WIDGET(info->ctx);
+  native_window_t* native_window =
+      (native_window_t*)widget_get_prop_pointer(wm, WIDGET_PROP_NATIVE_WINDOW);
+  canvas_t* c = native_window != NULL ? native_window_get_canvas(native_window) : NULL;
+
+  /* 走官方绘制路径（与主循环一致），先强制整屏重绘，再直接读 SDL lcd_mem 的 offline fb */
+  widget_invalidate_force(wm, NULL);
+  window_manager_paint(wm);
+
+  if (c != NULL && c->lcd != NULL) {
+    lcd_mem_t* lcd = (lcd_mem_t*)c->lcd;
+    uint8_t* fb = lcd_mem_get_offline_fb(lcd);
+
+    if (fb != NULL) {
+      uint32_t i;
+      bitmap_t b;
+      bitmap_init(&b, c->lcd->w, c->lcd->h, lcd->format, fb);
+      b.line_length = lcd->line_length;
+      bitmap_save_png(&b, s_screenshot);
+      log_debug("screenshot saved: %s (%d x %d, fmt=%d)\n", s_screenshot, c->lcd->w, c->lcd->h,
+                lcd->format);
+      log_debug("fb head bytes:");
+      for (i = 0; i < 32; i += 4) {
+        log_debug("  [%02x %02x %02x %02x]", fb[i], fb[i + 1], fb[i + 2], fb[i + 3]);
+      }
+    } else {
+      log_debug("screenshot failed: no offline fb!\n");
+    }
+  } else {
+    log_debug("screenshot failed: no canvas!\n");
+  }
+
+  tk_quit();
+
+  return RET_REMOVE;
+}
