<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="@dimen/dp_24" />
            <solid android:color="@color/seekbar_bg" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <shape>
            <corners android:radius="@dimen/dp_24" />
            <solid android:color="@color/seekbar_bg" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:scaleWidth="100%">
            <shape>
                <corners android:radius="@dimen/dp_24" />
                <gradient android:startColor="@color/gradient_color_start" android:endColor="@color/gradient_color_start" android:angle="0.0" />
            </shape>
        </clip>
    </item>
</layer-list>
