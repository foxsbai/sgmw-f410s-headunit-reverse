<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:topLeftRadius="@dimen/dp_4" android:topRightRadius="@dimen/dp_4" android:bottomLeftRadius="@dimen/dp_4" android:bottomRightRadius="@dimen/dp_4" />
            <solid android:color="#ff333333" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient android:startColor="#0336a1ff" android:endColor="#ff36a1ff" android:useLevel="true" android:angle="0.0" android:type="linear" />
                <corners android:topLeftRadius="@dimen/dp_4" android:topRightRadius="@dimen/dp_4" android:bottomLeftRadius="@dimen/dp_4" android:bottomRightRadius="@dimen/dp_4" />
            </shape>
        </clip>
    </item>
</layer-list>
