<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/dp_16" />
            <solid android:color="@color/bg_options_normal_press" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="@dimen/dp_16" />
            <solid android:color="@color/bg_options_normal_disable" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/dp_16" />
            <solid android:color="@color/bg_options_normal" />
        </shape>
    </item>
</selector>
