<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:topLeftRadius="@dimen/dp_20" android:topRightRadius="0.0dp" android:bottomLeftRadius="@dimen/dp_20" android:bottomRightRadius="0.0dp" />
            <solid android:color="@color/transparent" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient android:startColor="#001990ff" android:endColor="#ff1990ff" android:useLevel="true" android:angle="0.0" android:type="linear" />
                <corners android:topLeftRadius="@dimen/dp_20" android:topRightRadius="0.0dp" android:bottomLeftRadius="@dimen/dp_20" android:bottomRightRadius="0.0dp" />
            </shape>
        </clip>
    </item>
</layer-list>
